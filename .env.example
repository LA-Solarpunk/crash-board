# copy this to .env and fill in your actual values

# transit api
TRANSIT_API_KEY=your_transit_api_key_here

# location (crash space example)
LOCATION_LAT=34.0252
LOCATION_LON=-118.4687

# google calendar (optional)
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# weather (optional - get free key from openweathermap.org)
WEATHER_API_KEY=your_openweather_api_key

# space status endpoint (optional)
SPACE_STATUS_URL=https://your-space-api.com/status

# server port
PORT=3000
