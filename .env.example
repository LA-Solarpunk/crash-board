# copy this to .env and fill in your values. everything with a default is optional.

# LA Metro real-time via Swiftly (api.goswift.ly, free tier).
# leave blank to run on the fixed timetables in schedules/ only.
SWIFTLY_API_KEY=

# google calendar. the calendar must be public and the key needs the
# Calendar API enabled in the Google Cloud console.
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_API_KEY=

# location used for NWS weather. default: CRASH Space (Venice & Motor)
LOCATION_LAT=34.019254
LOCATION_LON=-118.405231

# page to scrape for open/closed status. default: https://crashspacela.com/sign/
#SPACE_STATUS_URL=https://crashspacela.com/sign/

# printer status service (not in this repo). default: http://archlinux:3001/
#PRINTER_API_URL=http://archlinux:3001/

# server port. default: 3000
PORT=3000
